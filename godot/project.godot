config_version=5

[application]
config/name="AImpire"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4")
config/version="0.8.0"
config/quit_on_go_back=false
config/project_settings_override="user://moteur.cfg"
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.07058824, 0.1254902, 0.10196079, 1)
boot_splash/show_image=false

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/energy_saving/keep_screen_on=false
window/handheld/orientation=5

[rendering]

renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

rendering_device/driver.macos="metal"

lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
environment/ssao/half_size=true
environment/ssao/quality=1
anti_aliasing/quality/msaa_3d=2
